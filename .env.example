# Discord bot (see docs/deploy_portainer.md for how to get these IDs)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Only used once, to turn the old single profile into the first stored profile
# (owned by the first DISCORD_MENTION_USER_ID). Also the ops fallback channel.
DISCORD_ALERT_CHANNEL_ID=
# Optional: separate channel for [SOURCE_ERROR]/[SOURCE_BLOCKED]; defaults to the alert channel
DISCORD_OPS_CHANNEL_ID=
# Only used once: owner of the seeded profile (first ID)
DISCORD_MENTION_USER_ID=
# Who may use /scrape, /pause, /resume (at least one of these is required)
DISCORD_CONTROL_USER_IDS=
DISCORD_CONTROL_ROLE_ID=
# Category the bot creates per-user alert channels in
HUUR_CATEGORY_NAME=Huur
SCRAPE_INTERVAL_MINUTES=10
# Weekly cleanup of the bot's own (unpinned) messages in the alert channel.
# Weekday name (monday..sunday or mon..sun), or off to disable. Hour is 0-23 in UTC.
LISTINGS_CLEAR_DAY=monday
LISTINGS_CLEAR_HOUR_UTC=4

# Runtime
DATABASE_PATH=data/huur_scraper.db
USER_AGENT=huur-scraper/0.1 (contact: your-email@example.com)
MAX_WORKERS=2
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
# Leave LOG_FILE_PATH empty to log to stdout only (the Docker image does this)
LOG_FILE_PATH=logs/huur_scraper.log
LOG_TO_CONSOLE=true

# Defaults for new profiles (and the seeded profile); each user edits theirs with /profile
MAX_RENT_EUR=1000
MIN_SIZE_M2=40
PREFERRED_BEDROOMS=2
ALLOW_CLOSE_MATCH=true

# Only used to seed the first profile's cities (comma-separated Zuid-Holland places)
ALLOWED_CITIES=Den Haag,Delft,Rijswijk,Voorburg,Leidschendam,Nootdorp,Ypenburg
